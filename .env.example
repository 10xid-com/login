# Migrations connect as the table owner.
DATABASE_URL=postgres://user:password@host:5432/portal
# The application connects as a RESTRICTED role that does not own the tables and
# has neither SUPERUSER nor BYPASSRLS. If these are the same connection string,
# row-level security is silently inactive and the app refuses to boot.
DATABASE_APP_URL=postgres://portal_app:password@host:5432/portal
# The one host where sign-in happens. Every other domain redirects here.
PRIMARY_HOST=login.10xid.com
# Where the portal pages live, if not on the login host. Unset, the login host
# serves both. Set, the login host keeps only /auth/* and sends every other page
# here. It gets its session by the same handoff as a client domain; the deploy
# step (scripts/migrate.mjs) registers it in organization_domains under the
# house company.
# Only the service answering on PRIMARY_HOST reads it.
PORTAL_HOST=
SESSION_COOKIE_SECURE=true
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# The workspace at /chat (lib/ai/engine/). Staff only.
#
# Intended Chat Boss provider: Ollama. Do not infer a model or base URL from
# this file; those remain deployment choices. The repository also contains
# Anthropic and OpenAI engine modes. They are retained as separate/optional
# integrations unless an explicit architecture decision removes or re-scopes
# them; this clarification does not rewrite unrelated AI integrations.
# ---------------------------------------------------------------------------

# Claude, through the Anthropic API (platform.claude.com). Paid per use.
ANTHROPIC_API_KEY=
# The model behind "Claude — Coding" and "Claude — Deep analysis". Unset means
# claude-opus-5-5; change these to move a mode to a newer model.
CLAUDE_MODEL_CODING=
CLAUDE_MODEL_DEEP=

# OpenAI, through the OpenAI API (platform.openai.com). Paid per use. Each
# mode needs a model name; there is deliberately no default.
OPENAI_API_KEY=
OPENAI_MODEL_MULTIMODAL=
OPENAI_MODEL_REVIEW=
# Whether OpenAI may store responses. Off unless "true".
OPENAI_STORE=

# Ollama. Ollama Cloud (ollama.com) unless OLLAMA_BASE_URL names another
# server; Ollama Cloud needs OLLAMA_API_KEY, a server of your own may not.
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
# The models, comma-separated: each is its own entry in the chat's model
# picker, and "Ollama — Auto" tries them in this order. Unset: gpt-oss:120b,
# kimi-k2.7-code, gemma4:31b, gpt-oss:20b (all on Ollama Cloud). A self-hosted
# server names its own.
OLLAMA_MODELS=
# Ollama Cloud as a PROTOTYPE engine: text only, no tools, and refused once a
# conversation involves a client. Off unless "true".
ENABLE_PROTOTYPE_ENGINE=
# "true" lets the Ollama Cloud entries (or the server OLLAMA_BASE_URL names, if
# not self-hosted) be sent client records and linked repository code: they get
# the job and repository tools and work in client workspaces. Ollama states it
# never logs or trains on prompts. Off unless "true".
OLLAMA_CLOUD_CLIENT_DATA=
# "true" ONLY when OLLAMA_BASE_URL is a server you run. Adds "Ollama —
# Self-hosted", which gets client context and tools like Claude, and replaces
# the prototype. Refused if OLLAMA_BASE_URL is unset or is ollama.com.
OLLAMA_SELF_HOSTED=

# The GitHub App the workspace reads repositories through. Read-only by
# installation (Contents: read, Metadata: read), and every token it mints is
# narrowed again to one repository. The private key is the .pem GitHub gives
# you; pasted on one line, "\n" is turned back into newlines.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Only for tests: a stand-in for api.github.com.
GITHUB_API_URL=

# Encrypts staff authenticator secrets at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32
TOTP_ENC_KEY=

# Google Drive — a folder per request, created by the portal's own service
# account rather than by borrowing somebody's Google login.
#
# Needs a Google Cloud project with the Drive API enabled, a service account,
# and ONE folder in Drive shared with that service account's address as Editor.
# The scope requested is drive.file, which reaches only files this application
# itself created — not the rest of the Drive it is working in.
#
# GOOGLE_SERVICE_ACCOUNT_KEY takes EITHER the whole downloaded JSON file
# (in which case the address is read out of it and the line below is not
# needed) OR just its private_key value.
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The id from the folder's address bar: drive.google.com/drive/folders/<THIS>
GOOGLE_DRIVE_PARENT_FOLDER_ID=
