# Migrations connect as the table owner.
DATABASE_URL=postgres://user:password@host:5432/portal
# The application connects as a RESTRICTED role that does not own the tables and
# has neither SUPERUSER nor BYPASSRLS. If these are the same connection string,
# row-level security is silently inactive and the app refuses to boot.
DATABASE_APP_URL=postgres://portal_app:password@host:5432/portal
# The one host where sign-in happens. Every other domain redirects here.
PRIMARY_HOST=login.10xid.com
# The portal (10xid-com/app). Required: the login host keeps only /auth/* and
# sends every other page here, and signing in ends here. It gets its session by
# the same handoff as a client domain; the deploy step (scripts/migrate.mjs)
# registers it in organization_domains under the house company.
PORTAL_HOST=app.10xid.com
# People whose sign-in ends at a UiD of their own instead of the portal:
# portal-account address=https address, comma-separated. Only https on a
# 10xid.com subdomain (not this host) is taken; anybody else goes to the
# portal. A redirect only: the UiD page keeps its own passcode.
#   UID_HOMES=paolo@10xid.com=https://uid-bypaolo.10xid.com/v3/,rana@example.com=https://uid-rana.10xid.com/
UID_HOMES=
# UiD pages that sign in through this host, and the portal accounts that may
# open each: host=address|address, comma-separated. UID_SITE_KEY (32+ random
# characters) derives each UiD's own secret, which its server holds as
# UID_SITE_SECRET. Without the key, no UiD signs in here.
#   UID_SITES=uid-rana.10xid.com=web@brandingcentres.com|paolo@tboxstudio.com,uid-bypaolo.10xid.com=paolo@tboxstudio.com
UID_SITES=
UID_SITE_KEY=
# Hostnames that are no longer ours, comma-separated. The deploy step deletes
# their organization_domains rows so the handoff stops minting tickets for
# them. A hostname still in PORTAL_CLIENT_DOMAINS or PORTAL_HOST is refused.
PORTAL_RETIRED_DOMAINS=
SESSION_COOKIE_SECURE=true
RESEND_API_KEY=


# --- Sign-in engine: Better Auth (0022) -------------------------------------
# 32+ random characters. Encrypts authenticator secrets, recovery codes and
# OAuth tokens. Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=
# The sign-in engine's own restricted role. The migration (scripts/migrate.mjs)
# sets portal_auth's password from PORTAL_AUTH_PASSWORD; AUTH_DATABASE_URL
# connects with it. Never the owner, never portal_app.
PORTAL_AUTH_PASSWORD=
AUTH_DATABASE_URL=postgres://portal_auth:password@host:5432/portal
# Optional providers: a button appears only when both values are set.
# Redirect URIs: https://login.10xid.com/api/auth/callback/google and
#                https://login.10xid.com/api/auth/callback/microsoft
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" (any account) unless restricted to one directory.
MICROSOFT_TENANT_ID=common
# Rate limits key on the client address from this header (Railway: x-real-ip).
CLIENT_IP_HEADER=x-real-ip
# From address for codes and invitations.
MAIL_FROM=10XiD <no-reply@10xid.com>
# Operators: who may use /auth/operator (confirm sign-ins for accounts from
# before, invite people, reset a lost authenticator). Comma-separated portal
# account addresses. Empty means nobody.
OPERATOR_EMAILS=
